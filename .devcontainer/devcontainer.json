{
  "name": "SmartFlow Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false,
      "installDockerComposeV2": true
    }
  },
  "forwardPorts": [5173, 3000, 80],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y make && cd frontend && npm install && cd ../backend && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma"
      ]
    }
  },
  "workspaceFolder": "/workspaces/smartflow",
  "privileged": true
}
